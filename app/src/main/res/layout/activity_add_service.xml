<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kategorija"
            android:layout_marginBottom="12dp">
            <AutoCompleteTextView
                android:id="@+id/etTipServisa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPodkategorija"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Podkategorija"
            android:layout_marginBottom="12dp"
            android:visibility="gone">
            <AutoCompleteTextView
                android:id="@+id/etPodkategorija"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dodaj ovo između tilPodkategorija i etOpis -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFilteri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardCornerRadius="10dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zamijenjeni filteri:"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>

                <CheckBox
                    android:id="@+id/cbFilterUlja"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter ulja"
                    android:textSize="14sp"
                    android:buttonTint="@color/primary"/>

                <CheckBox
                    android:id="@+id/cbFilterKlime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter klime"
                    android:textSize="14sp"
                    android:buttonTint="@color/primary"/>

                <CheckBox
                    android:id="@+id/cbFilterGoriva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter goriva"
                    android:textSize="14sp"
                    android:buttonTint="@color/primary"/>

                <CheckBox
                    android:id="@+id/cbFilterKabine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter kabine"
                    android:textSize="14sp"
                    android:buttonTint="@color/primary"/>

                <CheckBox
                    android:id="@+id/cbFilterZraka"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filter zraka"
                    android:textSize="14sp"
                    android:buttonTint="@color/primary"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Opis (opcionalno)"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOpis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="2"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cijena (KM)"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCijena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kilometraža pri servisu"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etKilometraza"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Datum servisa"
            android:layout_marginBottom="24dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDatum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:focusable="false"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Sačuvaj servisni zapis"
            android:textSize="16sp"
            android:backgroundTint="@color/primary"/>

    </LinearLayout>
</ScrollView>